# ===== AlphaGPT-Routine 配置模板 =====
# 复制成 config.env 后按需修改（config.env 已在 .gitignore 中，不会被提交）

# ---- 标的与时间区间 ----
# 注意：仓库自带的 margin_balance/ 两融缓存只有【沪市】数据（60/68/51 等开头），
# 用深市股票（000/002/300）时两融类因子会全部为 0。
INDEX_CODE=600519
START_DATE=20220101
END_DATE=20261231

# ---- 模型 / 训练 ----
BATCH_SIZE=1024
TRAIN_ITERATIONS=100      # 策略发现建议 100；只做每日信号可设 1
MAX_SEQ_LEN=10            # 公式最大复杂度
FORCE_TRAIN=True          # True=每次都重新训练；False=复用已有的 *_best_formula_*.txt
ONLY_LONG=True            # A 股做多市场设 True

# ---- 回测参数 ----
COST_RATE=0.0004          # 交易成本（印花税 + 手续费）
LAST_NDAYS=42             # 报表展示最近多少个交易日
HOLD_PERIOD=11            # 持仓周期（>=2）

# ---- 指定公式（二选一，可留空）----
# 1) BEST_FORMULA：只跑一个标的的指定公式
BEST_FORMULA=
# 2) CODE_FORMULA：可多行，格式 代码:公式
# CODE_FORMULA=600519:NEG(RET)
# CODE_FORMULA=600519:NEG(RET)
# 000300:MUL(RET5,TREND)

# ---- 钉钉推送（留空则不推送）----
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# ===== v2（横截面优化版）额外配置 =====
# 标的池：逗号分隔。默认 12 只沪市两融标的。
# ⚠️ 两融缓存只有沪市数据，深市标的（000/002/300）的 MARGIN_NET 因子会恒为 0
UNIVERSE=600519,600036,601318,600030,600276,600887,601899,600900,601088,600309,601166,600585

# 固定持有交易日数（v1 是"未来 2~11 天第一个正收益日"的择时，v2 改为固定持有）
HOLD_PERIOD=5

# A股真实交易成本（单边）
COMMISSION_RATE=0.00025     # 佣金
TRANSFER_FEE_RATE=0.00001   # 过户费
STAMP_TAX_RATE=0.0005       # 印花税（仅卖出）
SLIPPAGE_RATE=0.0005        # 滑点
LIMIT_RATE=0                # >0 时强制涨跌停比例（ST 股请设 0.05）

# 奖励函数（原始版核心：风险调整收益 + 风控约束）
MIN_TRADES=12               # 单只标的交易次数下限
MIN_STOCK_PASS=0.6          # 至少多少比例的标的达标
MAX_DD_PENALTY=3.0          # 回撤超阈值后的惩罚系数
DD_THRESHOLD=0.25           # 回撤惩罚阈值
LEN_PENALTY=0.03            # 公式复杂度惩罚
RISK_FREE_RATE=0.02         # 无风险利率

# 复现与性能
SEED=42                     # 固定随机种子，保证结果可复现
BATCH_CHUNK=64              # 回测分块大小（控制内存）
